# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
VITE_TENANT_SLUG=default

# Database
DATABASE_URL=mysql://brandpilot:brandpilot_pass@localhost:3306/brandpilot

# Redis
REDIS_URL=redis://localhost:6379

# Secrets (generate real values for production)
MASTER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
COOKIE_SECRET=change-me-in-production

# Storage (Hostinger S3-compatible or SFTP)
STORAGE_ENDPOINT=https://storage.hostinger.com
STORAGE_KEY=your-storage-key
STORAGE_SECRET=your-storage-secret
STORAGE_BUCKET=brandpilot

# Razorpay (store encrypted in config store in production; bootstrap only)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# AI Providers (store encrypted in config store in production; bootstrap only)
OPENAI_API_KEY=sk-...
RUNWAY_API_KEY=...
